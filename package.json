{
  "name": "launch-k",
  "productName": "Launch-K",
  "version": "1.2.0",
  "description": "個人用ランチャーデスクトップアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&&electron-builder"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "koffi": "2.9.0"
  },
  "build": {
    "appId": "com.kaseki.launchk",
    "productName": "Launch-K",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "koffi@2.9.0": true,
    "electron-winstaller@5.4.0": true
  },
  "author": "Launch-K"
}
